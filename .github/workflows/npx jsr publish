name: Publish

on:
  push:
    branches:
      - main

jobs:
  publish:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write # The OIDC ID token is used for authentication with JSR.
    steps:
      # Pinned to the exact commit SHA for actions/checkout v6
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v6
      
      # Tell the runner to execute the publish command inside your subfolder
      - name: Publish to JSR
        run: npx jsr publish
        working-directory: ./web-app-router-
