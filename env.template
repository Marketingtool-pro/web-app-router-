# MarketingTool Web App — build configuration template
#
# Copy this to `.env` in the repo root BEFORE running `npm run build`.
# Vite reads it from the current working directory, so build from the repo root
# (never `npm --prefix <dir>`, which leaves cwd elsewhere and loads nothing).
#
# The real `.env` is missing from the working copy. Without it every value below
# falls back and the build is broken in four visible ways:
#   1. Appwrite resolves to http://localhost/v1 with an empty project -> login dies
#   2. Firebase initialises with undefined values
#   3. MUI X Pro components render the "Missing license key" watermark
#   4. Supabase client (template scaffolding) gets undefined config
#
# Values marked VERIFIED were read from the live system on 2026-09-11 and are safe
# to use as-is. The rest must be filled in from your own records.
# Never commit the completed `.env`.

# ── Appwrite (auth) ────────────────────────────────────────────────────────────
# VERIFIED: endpoint and project id read from the running Appwrite instance.
VITE_APPWRITE_ENDPOINT=https://api.marketingtool.pro/v1
VITE_APPWRITE_PROJECT_ID=6952c8a0002d3365625d

# ── Windmill (all backend logic) ───────────────────────────────────────────────
# VERIFIED: must point at the VPS 2 proxy, NOT wm.marketingtool.pro.
# The proxy injects the Windmill token server-side; the frontend holds no token.
# There is deliberately no VITE_WINDMILL_TOKEN — the source is token-free.
VITE_WINDMILL_URL=https://app.marketingtool.pro
VITE_WINDMILL_WORKSPACE=marketingtool-pro

# ── MUI X Pro licence ──────────────────────────────────────────────────────────
# Required. The app imports @mui/x-charts-pro, @mui/x-data-grid-pro and
# @mui/x-date-pickers-pro across ~37 files; without a key every one watermarks.
# src/config/muiLicense.js reads VITE_MUI_X_LICENSE_KEY first, then the VITE_APP_ form.
# Either of your two Pro keys works: both carry the same plan and package version.
VITE_MUI_X_LICENSE_KEY=
VITE_APP_MUI_X_LICENSE_KEY=

# ── Firebase ───────────────────────────────────────────────────────────────────
# src/config/firebase.ts calls initializeApp with these.
VITE_APP_FIREBASE_API_KEY=
VITE_APP_FIREBASE_AUTH_DOMAIN=
VITE_APP_FIREBASE_PROJECT_ID=
VITE_APP_FIREBASE_STORAGE_BUCKET=
VITE_APP_FIREBASE_MESSAGING_SENDER_ID=
VITE_APP_FIREBASE_APP_ID=
VITE_APP_FIREBASE_MEASUREMENT_ID=

# ── Supabase ───────────────────────────────────────────────────────────────────
# Only src/utils/auth-client/supabase.js reads these, and it is SaasAble template
# scaffolding for an auth provider this project does not use (AUTH_PROVIDER is
# Appwrite). Leave blank unless you deliberately enable it — the rule is that the
# frontend never queries Supabase.
VITE_APP_SUPABASE_URL=
VITE_APP_SUPABASE_ANON_KEY=

# ── App metadata ───────────────────────────────────────────────────────────────
VITE_APP_BASE_URL=/
VITE_APP_VERSION=
VITE_APP_API_HOST=

# ── Analytics (optional) ───────────────────────────────────────────────────────
VITE_APP_ANALYTICS_ID=
VITE_APP_CLARITY_ID=
VITE_APP_NOTIFY_ID=

# ── AWS Cognito ────────────────────────────────────────────────────────────────
# Template scaffolding for an unused auth provider. Leave blank.
VITE_APP_AWS_REGION=
VITE_APP_AWS_USER_POOL_ID=
VITE_APP_AWS_USER_POOL_WEB_CLIENT_ID=
